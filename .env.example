# Google Gemini (server-side only)
GEMINI_API_KEY=your-gemini-api-key
# Use a NON-thinking Flash/Flash-Lite model. Reasoning models (e.g. gemini-4-argon)
# and `*-latest` aliases that resolve to a thinking-first model return empty text
# at typical maxOutputTokens — avoid them for this JSON-synthesis path.
# gemini-3.5-flash-lite is the tested default. (gemini-2.5-flash also works but
# access to 2.5 models is now limited to prior users, so a new key may not reach it.)
# The code reads the id from this variable — never hardcoded, so changing it here is enough.
GEMINI_MODEL=gemini-3.5-flash-lite

# Tavily web search (server-side only)
TAVILY_API_KEY=your-tavily-api-key

# SQLite database file path (optional; defaults to ./data/guides.db)
DATABASE_PATH=./data/guides.db
