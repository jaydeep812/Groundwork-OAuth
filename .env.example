# Google Gemini (server-side only)
GEMINI_API_KEY=your-gemini-api-key
# IMPORTANT: `gemini-flash-latest` currently resolves to a thinking-first model
# that returns empty text at typical maxOutputTokens. Use gemini-2.5-flash for
# the fast path. The code reads the model id from this variable — never
# hardcoded, so changing it here is enough.
GEMINI_MODEL=gemini-2.5-flash

# Tavily web search (server-side only)
TAVILY_API_KEY=your-tavily-api-key

# SQLite database file path (optional; defaults to ./data/guides.db)
DATABASE_PATH=./data/guides.db
